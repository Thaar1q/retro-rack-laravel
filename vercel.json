{
    "version": 2,
    "buildCommand": "composer install --no-dev --optimize-autoloader && npm ci && npm run build",
    "builds": [
        { "src": "api/index.php", "use": "vercel-php@0.7.4" }
    ],
    "routes": [
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr"
    }
}
